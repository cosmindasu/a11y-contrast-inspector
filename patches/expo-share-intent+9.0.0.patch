+            // PATCHED (see patches/expo-share-intent+9.0.0.patch).
+            // The original did `resolver.query(...)!!`, ignored the result of
+            // moveToFirst() and passed getColumnIndex() straight to getString().
+            // A provider may legitimately return null, an empty cursor, or omit
+            // DISPLAY_NAME/SIZE -- e.g. when the sharing app hands over a URI
+            // the receiver has no read grant for. Every one of those crashed the
+            // app on the main thread with CursorIndexOutOfBoundsException, from
+            // onNewIntent, with no message to the user. The name and size are
+            // cosmetic, so degrade instead of dying.
+            var fileName: String? = null
+            var fileSize: String? = null
+            resolver.query(uri, null, null, null, null)?.use { c ->
