+                    if (nameIndex >= 0) fileName = c.getString(nameIndex)
+                    val sizeIndex = c.getColumnIndex(OpenableColumns.SIZE)
+                    if (sizeIndex >= 0) fileSize = c.getString(sizeIndex)
+                }
+            }
 
